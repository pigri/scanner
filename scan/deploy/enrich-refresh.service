[Unit]
Description=gen0sec discovery enrich-refresh (resolve + PTR + MMDB, filter phantoms)
After=network-online.target
Wants=network-online.target
# Runs after ct-mirror on the same 30-min cadence but offset by ~15 min so a
# freshly-enqueued host is enriched within one cycle. scanvpn-netns.service is
# a system unit; user systemd can't Requires= it — ExecStartPre polls instead.

[Service]
Type=oneshot
WorkingDirectory=/home/pigri/gen0sec/redteam/discovery
# Wait up to 60s for the ns to appear (same guard as ct-mirror + scan-worker).
ExecStartPre=/usr/bin/sudo /usr/bin/bash -c 'for i in $(seq 30); do /usr/sbin/ip netns pids scanvpn >/dev/null 2>&1 && exit 0; sleep 2; done; echo "scanvpn netns absent after 60s — refusing to start" >&2; exit 1'
# --skip-ct + --skip-brute keeps this cycle enrich-only. Slow parents-driven
# CT/brute refresh stays a manual `refresh` invocation (or a slower timer).
ExecStart=/usr/bin/sudo /usr/sbin/ip netns exec scanvpn /usr/sbin/runuser -u pigri -- \
  /usr/bin/bash -lc 'export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh"; export PATH="$HOME/.local/bin:$PATH"; mkdir -p logs && exec npx tsx src/refresh.ts --skip-ct --skip-brute >> logs/enrich-refresh.log 2>&1'

[Install]
WantedBy=default.target
