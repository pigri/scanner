[Unit]
Description=gen0sec discovery enrich-refresh (resolve + PTR + MMDB, filter phantoms)
After=network-online.target
Wants=network-online.target
# Runs on a 30-min cadence, offset ~15 min after ct-mirror so a freshly-enqueued
# host is enriched within one cycle. Runs in the MAIN namespace (not scanvpn):
# recon DNS needs no VPN egress, and the netns's in-tunnel resolver is
# flaky/rate-limited — resolving there is what ratcheted live hosts into
# phantoms.txt. This matches the daily scan-feed pass, which already resolves
# in the main namespace, so the two now agree on what resolves (they disagreed
# while this ran in the netns). The resolver set itself is enrich's own default.

[Service]
Type=oneshot
WorkingDirectory=/home/pigri/gen0sec/redteam/discovery
# --skip-ct + --skip-brute keeps this cycle enrich-only. The slow parents-driven
# CT/brute refresh stays a manual `refresh` invocation (or a slower timer).
ExecStart=/bin/bash -lc 'export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh"; export PATH="$HOME/.local/bin:$PATH"; mkdir -p logs && exec npx tsx src/refresh.ts --skip-ct --skip-brute >> logs/enrich-refresh.log 2>&1'

[Install]
WantedBy=default.target
