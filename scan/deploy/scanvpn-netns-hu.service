[Unit]
Description=scanvpn-hu WireGuard network namespace (HU VPN egress for scan-worker-hu)
Documentation=man:wg(8) man:ip-netns(8)
After=network-online.target nss-lookup.target
Wants=network-online.target
# The WireGuard endpoint hostname (from scanvpn-hu.conf) must resolve at setup
# time; keep retrying if the network or DNS is not ready yet at boot.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/scanvpn-netns-hu.sh up
ExecStop=/usr/local/sbin/scanvpn-netns-hu.sh down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
