[Unit]
Description=gen0sec CT-mirror update (scrape-ct-log -> enqueue new scope-matched hosts)
After=network-online.target
Wants=network-online.target
# On a non-zero exit, emit a ct_status error event to Axiom.
OnFailure=ct-mirror-alert.service

[Service]
Type=oneshot
WorkingDirectory=/home/pigri/gen0sec/redteam/discovery
# CT logs (ct.googleapis.com, ct.cloudflare.com, crt.sh) are PUBLIC transparency
# logs and the mirror pulls whole shards, filtering to scope locally — so the
# pull reveals nothing about our targets and needs no VPN egress. Run it on the
# host network directly: routing it through the scanvpn netns only coupled CT
# freshness to the tunnel's health (a dead tunnel silently froze the mirror on
# DNS failures, since the netns's only resolver is in-tunnel). The hosts this
# discovers are still scanned via the VPN by the workers; only the public-log
# fetch runs here.
#
# Per-shard per-run entry cap (ct-mirror.ts CT_MAX_ENTRIES, default 500k). Raised
# to 5M to catch up a large historical backlog: argon2026h2 was ~355M entries
# behind log head, which at 500k/run every 30min is ~15 days — in-scope certs
# only appear near the head, so new CT findings were effectively paused until
# caught up. 5M/shard/run reaches the head in ~1.5 days. The mirror iterates in
# 20k-entry chunks and checkpoints after each, so a longer run resumes safely and
# intermediate files stay small. A run may exceed the 30min timer window, but
# systemd never runs two instances of this (non-templated) service, so a trigger
# that lands mid-run is merged, not stacked — no overlap. (The OnCalendar timer
# ticks at :00/:30; a tick during a long run is dropped, and the next fire is the
# following half-hour tick — a <=30min gap, not a +30min-from-start gap — so
# catch-up runs stay effectively back-to-back.) Safe to leave high at steady state: far
# fewer than 5M certs append per interval, so it just fetches whatever is new.
Environment=CT_MAX_ENTRIES=5000000
# nvm must be sourced explicitly under systemd's clean environment.
# ../scan/.env.scan supplies the Axiom env for the end-of-update ct_status emission.
# scrape-ct-log resolves via ~/.local/bin (added to PATH inside the shell).
ExecStart=/usr/bin/bash -lc 'export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh"; export PATH="$HOME/.local/bin:$PATH"; ENVFILE="$PWD/../scan/.env.scan"; [ -r "$ENVFILE" ] && set -a && . "$ENVFILE" && set +a; mkdir -p logs && exec npx tsx src/ct-mirror.ts update >> logs/ct-mirror.log 2>&1'

[Install]
WantedBy=default.target
