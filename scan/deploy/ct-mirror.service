[Unit]
Description=gen0sec CT-mirror update (scrape-ct-log -> enqueue new scope-matched hosts)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pigri/gen0sec/redteam/discovery
# CT logs (ct.googleapis.com, ct.cloudflare.com, crt.sh) are PUBLIC transparency
# logs and the mirror pulls whole shards, filtering to scope locally — so the
# pull reveals nothing about our targets and needs no VPN egress. Run it on the
# host network directly: routing it through the scanvpn netns only coupled CT
# freshness to the tunnel's health (a dead tunnel silently froze the mirror on
# DNS failures, since the netns's only resolver is in-tunnel). The hosts this
# discovers are still scanned via the VPN by the workers; only the public-log
# fetch runs here.
#
# nvm must be sourced explicitly under systemd's clean environment.
# scrape-ct-log resolves via ~/.local/bin (added to PATH inside the shell).
ExecStart=/usr/bin/bash -lc 'export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh"; export PATH="$HOME/.local/bin:$PATH"; mkdir -p logs && exec npx tsx src/ct-mirror.ts update >> logs/ct-mirror.log 2>&1'

[Install]
WantedBy=default.target
