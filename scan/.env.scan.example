# Worker env — sourced by scan-worker*.service before invoking worker.ts.
# Copy to .env.scan (gitignored) and edit. Missing file is fine; the workers
# skip sourcing without error.

# WPScan API token — unlocks CVE data for wpscan runs (plugin/theme vulns).
# Register a free account at https://wpscan.com/api for 25 daily requests,
# or purchase a paid tier for higher quotas.
WPSCAN_API_TOKEN=
